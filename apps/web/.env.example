# ── TokenLens web — environment ────────────────────────────────────────────────
# Kopieer naar .env.local (lokaal) of zet als secrets op de server.
# De publieke + SEO-pagina's werken ZONDER Supabase; het dashboard/login niet.

# Supabase (gratis project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (ingest/cron) — NOOIT naar de client
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Publieke URL van de site (voor sitemap, canonicals, OG). Geen trailing slash.
NEXT_PUBLIC_SITE_URL=https://tokenlens.dev

# Link naar de GitHub-repo (gebruikt op landing + chrome).
NEXT_PUBLIC_GITHUB_URL=https://github.com/USER/tokenlens

# Budget-alerts cron — verzin een lang geheim; de cron-URL gebruikt ?token=<dit>.
CRON_SECRET=

# E-mail-alerts via Resend (gratis tot 3.000/mnd). Leeg = e-mail uit, geen crash.
RESEND_API_KEY=
RESEND_FROM=TokenLens <alerts@tokenlens.dev>

# Runtime (server). Op de VM gezet via systemd EnvironmentFile.
# PORT=3000
# HOSTNAME=127.0.0.1
# NODE_ENV=production
