{
  "name": "tokenlens-sdk",
  "version": "0.1.0",
  "description": "FinOps for LLMs — cost attribution per customer/feature/team for OpenAI & Anthropic.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/pricing.js",
    "dist/pricing.d.ts",
    "dist/types.js",
    "dist/types.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "finops",
    "cost",
    "openai",
    "anthropic",
    "token",
    "attribution",
    "observability"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jaydendufour-maker/tokenlens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaydendufour-maker/tokenlens.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/jaydendufour-maker/tokenlens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.5.0"
  }
}
